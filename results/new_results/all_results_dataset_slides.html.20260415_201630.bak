on-event-allversions__counter_imaging", "m6_two_pass_two__finetuned_ms-500-individuating-opinion-action-event-allversions__individuating", "m6_two_pass_two__finetuned_ms-500-perspective-taking-opinion-action-event-allversions__perspective_taking", "m6_two_pass_two__finetuned_ms-500-positive-contact-opinion-action-event-allversions__positive_contact", "m6_two_pass_two__finetuned_ms-500-stereotype-replacement-opinion-action-event-allversions__stereotype_replacement"], "winogender": ["m6_two_pass_two__base__all_strategies", "m6_two_pass_two__base__counter_imaging", "m6_two_pass_two__base__individuating", "m6_two_pass_two__base__perspective_taking", "m6_two_pass_two__base__positive_contact", "m6_two_pass_two__base__stereotype_replacement", "m6_two_pass_two__finetuned_ms-500-allstrategies-action__all_strategies", "m6_two_pass_two__finetuned_ms-500-allstrategies-event__all_strategies", "m6_two_pass_two__finetuned_ms-500-allstrategies-opinion-action-event-allversions__all_strategies", "m6_two_pass_two__finetuned_ms-500-allstrategies-opinion__all_strategies", "m6_two_pass_two__finetuned_ms-500-counter-imaging-opinion-action-event-allversions__counter_imaging", "m6_two_pass_two__finetuned_ms-500-individuating-opinion-action-event-allversions__individuating", "m6_two_pass_two__finetuned_ms-500-perspective-taking-opinion-action-event-allversions__perspective_taking", "m6_two_pass_two__finetuned_ms-500-positive-contact-opinion-action-event-allversions__positive_contact", "m6_two_pass_two__finetuned_ms-500-stereotype-replacement-opinion-action-event-allversions__stereotype_replacement"], "bbq": ["m6_two_pass_two__base__all_strategies", "m6_two_pass_two__base__counter_imaging", "m6_two_pass_two__base__individuating", "m6_two_pass_two__base__perspective_taking", "m6_two_pass_two__base__positive_contact", "m6_two_pass_two__base__stereotype_replacement", "m6_two_pass_two__finetuned_ms-500-counter-imaging-opinion-action-event-allversions__counter_imaging", "m6_two_pass_two__finetuned_ms-500-individuating-opinion-action-event-allversions__individuating", "m6_two_pass_two__finetuned_ms-500-perspective-taking-opinion-action-event-allversions__perspective_taking", "m6_two_pass_two__finetuned_ms-500-positive-contact-opinion-action-event-allversions__positive_contact", "m6_two_pass_two__finetuned_ms-500-stereotype-replacement-opinion-action-event-allversions__stereotype_replacement"]}}</script>
  <script id="dataset-order" type="application/json">["__overview__", "crowspairs", "stereoset", "winobias", "winogender", "bbq", "balanced_copa", "arc_easy", "arc_challenge", "bias_in_bios", "bold", "honest", "unqover_gender", "unqover_nationality", "unqover_race", "unqover_religion"]</script>
  <script id="dataset-meta" type="application/json">{"crowspairs": {"label": "CrowS-Pairs", "direction": "target50", "score_label": "metric_score"}, "stereoset": {"label": "StereoSet", "direction": "higher", "score_label": "ICAT Score"}, "bbq": {"label": "BBQ", "direction": "lower", "score_label": "mean_abs_bias_disambig"}, "balanced_copa": {"label": "Balanced-COPA", "direction": "higher", "score_label": "accuracy"}, "arc_easy": {"label": "ARC-Easy", "direction": "higher", "score_label": "accuracy"}, "arc_challenge": {"label": "ARC-Challenge", "direction": "higher", "score_label": "accuracy"}, "bold": {"label": "BOLD", "direction": "lower", "score_label": "toxicity_prop"}, "honest": {"label": "HONEST", "direction": "lower", "score_label": "honest_score"}, "winobias": {"label": "WinoBias", "direction": "lower", "score_label": "abs_pro_anti_gap"}, "winogender": {"label": "WinoGender", "direction": "lower", "score_label": "mean_abs_occupation_gender_bias_score"}, "bias_in_bios": {"label": "Bias in Bios", "direction": "lower", "score_label": "mean_abs_tpr_gap"}, "unqover_gender": {"label": "UnQover (Gender)", "direction": "lower", "score_label": "mu_bias_intensity"}, "unqover_race": {"label": "UnQover (Race)", "direction": "lower", "score_label": "mu_bias_intensity"}, "unqover_religion": {"label": "UnQover (Religion)", "direction": "lower", "score_label": "mu_bias_intensity"}, "unqover_nationality": {"label": "UnQover (Nationality)", "direction": "lower", "score_label": "mu_bias_intensity"}, "__overview__": {"label": "Overview (Plots)", "direction": "higher", "score_label": "normalized_performance"}}</script>
  <script>
    const rows = JSON.parse(document.getElementById("data-json").textContent);
    const rawM6Audited = JSON.parse(document.getElementById("m6-audited-json").textContent);
    const datasetOrder = JSON.parse(document.getElementById("dataset-order").textContent);
    const datasetMeta = JSON.parse(document.getElementById("dataset-meta").textContent);
    const M6_AUDITED = Object.fromEntries(
      Object.entries(rawM6Audited).map(([shot, datasets]) => [
        shot,
        Object.fromEntries(
          Object.entries(datasets || {}).map(([dkey, tags]) => [dkey, new Set(tags || [])])
        )
      ])
    );
    const VIEWS = [
      { key: "bias", label: "Bias Results" },
      { key: "reasoning", label: "Reasoning Ability Results" },
    ];

    const state = {
      showMethods: true,
      showBaselines: true,
      showBaseModel: true,
      search: "",
      selectedMethodFamilies: new Set(),
      methodFamiliesInitialized: false,
      viewIndex: 0
    };

    const els = {
      viewPrev: document.getElementById("viewPrev"),
      viewNext: document.getElementById("viewNext"),
      viewLabel: document.getElementById("viewLabel"),
      showMethods: document.getElementById("showMethods"),
      showBaselines: document.getElementById("showBaselines"),
      showBaseModel: document.getElementById("showBaseModel"),
      methodFamilyFilters: document.getElementById("methodFamilyFilters"),
      search: document.getElementById("search"),
      metricInfo: document.getElementById("metricInfo"),
      countInfo: document.getElementById("countInfo"),
      overviewPanel: document.getElementById("overviewPanel"),
      plotDatasetGrid: document.getElementById("plotDatasetGrid")
    };

    function currentView() {
      return VIEWS[state.viewIndex] || VIEWS[0];
    }

    function updateViewNav() {
      const view = currentView();
      els.viewLabel.textContent = view.label;
      els.viewPrev.disabled = state.viewIndex <= 0;
      els.viewNext.disabled = state.viewIndex >= VIEWS.length - 1;
    }

    function directionNote(direction) {
      if (direction === "higher") return "higher is better";
      if (direction === "target50") return "closer to 50 is better";
      return "lower is better";
    }

    function scoreQuality(row, list) {
      const direction = row.direction;
      if (row.score === null || row.score === undefined || row.score === "") return "var(--mid)";
      const values = list.map(r => Number(r.score)).filter(v => Number.isFinite(v));
      if (!values.length) return "var(--mid)";
      if (direction === "target50") {
        const distances = values.map(v => Math.abs(v - 50));
        const d = Math.abs(Number(row.score) - 50);
        const minD = Math.min(...distances);
        const maxD = Math.max(...distances);
        const t = (d - minD) / ((maxD - minD) || 1);
        if (t < 0.34) return "var(--good)";
        if (t < 0.67) return "var(--mid)";
        return "var(--bad)";
      }
      const min = Math.min(...values);
      const max = Math.max(...values);
      const v = Number(row.score);
      let t = (v - min) / ((max - min) || 1);
      if (direction === "higher") t = 1 - t;
      if (t < 0.34) return "var(--good)";
      if (t < 0.67) return "var(--mid)";
      return "var(--bad)";
    }

    function normInDataset(direction, value, values) {
      if (!Number.isFinite(value) || !values.length) return null;
      if (direction === "target50") {
        const dists = values.map(v => Math.abs(v - 50));
        const d = Math.abs(value - 50);
        const minD = Math.min(...dists);
        const maxD = Math.max(...dists);
        if (maxD === minD) return 1;
        return Math.max(0, Math.min(1, 1 - ((d - minD) / (maxD - minD))));
      }
      const min = Math.min(...values);
      const max = Math.max(...values);
      if (max === min) return 1;
      let t = (value - min) / (max - min);
      if (direction === "lower") t = 1 - t;
      return Math.max(0, Math.min(1, t));
    }

    function rowsForDataset(dkey) {
      const q = state.search.trim().toLowerCase();
      return rows.filter(r => {
        if (r.dataset_key !== dkey) return false;
        if (!state.showMethods && r.type === "method") return false;
        if (!passesMethodFamilyFilter(r)) return false;
        if (!state.showBaselines && r.type === "baseline") return false;
        if (!q) return true;
        const blob = `${r.type} ${r.name} ${r.strategy} ${r.run_tag} ${r.settings} ${r.source_file}`.toLowerCase();
        return blob.includes(q);
      });
    }

    const PLOT_VARIANTS = [
