      ],
      arc_challenge: [
        { key: "accuracy", label: "Accuracy", direction: "higher" }
      ]
    };

    const REASONING_MODEL_VARIANTS = [
      {
        key: "base",
        group: "base model",
        label: "base",
        rowType: "base_model",
        runStem: "reasoning_check__base__",
      },
      {
        key: "ft_sr",
        group: "m3 ft (ms-500)",
        label: "ft sr",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-stereotype-replacement-opinion-action-event-allversions__",
      },
      {
        key: "ft_ci",
        group: "m3 ft (ms-500)",
        label: "ft ci",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-counter-imaging-opinion-action-event-allversions__",
      },
      {
        key: "ft_ind",
        group: "m3 ft (ms-500)",
        label: "ft ind",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-individuating-opinion-action-event-allversions__",
      },
      {
        key: "ft_pt",
        group: "m3 ft (ms-500)",
        label: "ft pt",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-perspective-taking-opinion-action-event-allversions__",
      },
      {
        key: "ft_pc",
        group: "m3 ft (ms-500)",
        label: "ft pc",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-positive-contact-opinion-action-event-allversions__",
      },
      {
        key: "ft_all_action",
        group: "m3 ft (ms-500)",
        label: "ft allstrat action",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-allstrategies-action__",
      },
      {
        key: "ft_all_event",
        group: "m3 ft (ms-500)",
        label: "ft allstrat event",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-allstrategies-event__",
      },
      {
        key: "ft_all_opinion",
        group: "m3 ft (ms-500)",
        label: "ft allstrat opinion",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-allstrategies-opinion__",
      },
      {
        key: "ft_all_allv",
        group: "m3 ft (ms-500)",
        label: "ft allstrat allv",
        rowType: "method",
        runStem: "reasoning_check__finetuned_ms-500-allstrategies-opinion-action-event-allversions__",
      },
    ];

    const PINNED_METRIC_ORDER = [
      "crowspairs|metric_score",
      "stereoset|ICAT Score",
      "bbq|Bias_score_disambig",
      "bbq|Bias_score_ambig",
      "winobias|abs_pro_anti_gap",
      "winogender|male_female_pair_disagreement_rate",
    ];
    const PINNED_METRIC_INDEX = Object.fromEntries(
      PINNED_METRIC_ORDER.map((k, i) => [k, i])
    );

    function metricValue(row, metricKey) {
      if (!row) return null;
      const metrics = (row.metrics && typeof row.metrics === "object") ? row.metrics : {};
      if (Object.prototype.hasOwnProperty.call(metrics, metricKey)) {
        const v = Number(metrics[metricKey]);
        if (Number.isFinite(v)) return v;
      }
      if (metricKey === "score") {
        const fallback = Number(row.score);
        if (Number.isFinite(fallback)) return fallback;
      }
      return null;
    }

    function hasFiniteMetric(row, metricKey) {
      return Number.isFinite(metricValue(row, metricKey));
    }

    function pickBestRow(candidates) {
      if (!candidates.length) return null;
      return candidates.slice().sort((a, b) => {
        const as = hasFiniteMetric(a, "score") ? 1 : 0;
        const bs = hasFiniteMetric(b, "score") ? 1 : 0;
        if (as !== bs) return bs - as;
        return Number(b._mtime_ts || 0) - Number(a._mtime_ts || 0);
      })[0];
    }

    function methodRowsByName(dkey, methodName) {
      return rows.filter(r =>
        r.dataset_key === dkey &&
        r.type === "method" &&
        String(r.name || "") === methodName &&
        !r._placeholder
      );
    }

    function selectM3Row(dkey, variant, methodName) {
      const pool = methodRowsByName(dkey, methodName);
      for (const rx of variant.m3Regexes) {
        const cands = pool.filter(r => rx.test(String(r.run_tag || "")));
        if (cands.length) return pickBestRow(cands);
      }
      return null;
    }

    function selectM4Ft500Row(dkey, variant, versionTag) {
      const pool = methodRowsByName(dkey, "m4_ft500_instruction_versions");
      const rx = new RegExp(`^m4_ft500_${variant.m4Stem}_${versionTag}_${dkey}$`);
      const cands = pool.filter(r => rx.test(String(r.run_tag || "")));
      return pickBestRow(cands);
    }

    function selectM5Row(dkey, variant, modeTag) {
      const pool = [
        ...methodRowsByName(dkey, "m5_soft_prompt_42x4"),
        ...methodRowsByName(dkey, "m5_soft_prompt_42xbbq"),
        ...methodRowsByName(dkey, "m5_soft_prompting"),
      ];
      for (const suffix of (variant.m5Suffixes || [])) {
        const exactTag = `${modeTag}__${suffix}`;
        const exact = pool.filter(r => String(r.run_tag || "") === exactTag);
        if (exact.length) return pickBestRow(exact);
      }
      return null;
    }

    function selectM6Row(dkey, variant, modeTag) {
      const pool = methodRowsByName(dkey, "m6_self_debiasing");
      const suffixes = variant.m6Suffix
        ? [String(variant.m6Suffix)]
        : (variant.m5Suffixes || []);
      const shotKey =
        modeTag === "m6_two_pass" ? "0-shot"
        : modeTag === "m6_two_pass_one" ? "1-shot"
        : modeTag === "m6_two_pass_two" ? "2-shot"
        : "";
      for (const suffix of suffixes) {
        const exactTag = `${modeTag}__${suffix}`;
        if (shotKey) {
          const allowed = (M6_AUDITED[shotKey] || {})[dkey];
          if (!(allowed && allowed.has(exactTag))) continue;
        }
        // m6 run tags append extra descriptors after mode+variant prefix.
        const exact = pool.filter(r => String(r.run_tag || "") === exactTag);
        if (exact.length) return pickBestRow(exact);
        const prefixed = pool.filter(r => String(r.run_tag || "").startsWith(`${exactTag}_`));
        if (prefixed.length) return pickBestRow(prefixed);
      }
      return null;
    }

    function makePlotRow(dkey, groupName, variantLabel, sourceRow, rowType = "method") {
      return {
        dataset_key: dkey,
        type: rowType,
        name: groupName,
        strategy: variantLabel,
        run_tag: sourceRow ? String(sourceRow.run_tag || "") : "",
        score: sourceRow ? sourceRow.score : null,
        metrics: sourceRow && sourceRow.metrics ? sourceRow.metrics : {},
        _missing: !sourceRow
      };
    }

    function plotRowsForDatasetFixed(dkey) {
      const result = [];
      for (const v of PLOT_VARIANTS) {
        result.push(makePlotRow(dkey, "m3 ft (ms-500)", v.label, selectM3Row(dkey, v, "m3_finetune_llama_ms500")));
      }
      for (const v of PLOT_VARIANTS) {
        result.push(makePlotRow(dkey, "m3 ft (ms-full)", v.label, selectM3Row(dkey, v, "m3_finetune_llama_msfull")));
      }
      // Keep m4/m5 hidden for now; include only audited-correct m6 rows.
      for (const v of M6_PLOT_VARIANTS) {
        const rowZero = selectM6Row(dkey, v, "m6_two_pass");
        if (rowZero) result.push(makePlotRow(dkey, "m6 self-debias (two-pass 0-shot)", v.label, rowZero));
        const rowOne = selectM6Row(dkey, v, "m6_two_pass_one");
        if (rowOne) result.push(makePlotRow(dkey, "m6 self-debias (two-pass 1-shot)", v.label, rowOne));
        const rowTwo = selectM6Row(dkey, v, "m6_two_pass_two");
        if (rowTwo) result.push(makePlotRow(dkey, "m6 self-debias (two-pass 2-shot)", v.label, rowTwo));
      }
      for (const v of M6_NONCOG_PLOT_VARIANTS) {
        const rowNoncog = selectM6Row(dkey, v, "m6_noncog_two_pass");
        if (rowNoncog) result.push(makePlotRow(dkey, "m6 self-debias (non-cog)", v.label, rowNoncog));
      }
      return result;
    }

    function baselinePlotRowsForDataset(dkey) {
      const dedup = new Map();
      const baselineRows = rows
        .filter(r =>
          r.dataset_key === dkey &&
          r.type === "baseline" &&
          !r._placeholder
        );
      for (const r of baselineRows) {
        const key = `${String(r.name || "").trim()}|||${String(r.run_tag || "").trim()}`;
        const prev = dedup.get(key);
        if (!prev) {
          dedup.set(key, r);
          continue;
        }
        const prevTs = Number(prev._mtime_ts || 0);
        const nextTs = Number(r._mtime_ts || 0);
        if (nextTs >= prevTs) dedup.set(key, r);
      }
      return [...dedup.values()]
        .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")))
        .map(r => ({
          dataset_key: dkey,
          type: String(r.name || "") === "llama_8b_base" ? "base_model" : "baseline",
          name: String(r.name || "") === "llama_8b_base" ? "base model" : String(r.name || ""),
          strategy: String(r.name || "") === "llama_8b_base" ? "base model" : "baseline",
          run_tag: String(r.run_tag || ""),
          score: r.score,
          metrics: r.metrics || {},
          _missing: false
        }));
    }

    function plotRowsForDatasetCombined(dkey) {
      return [...plotRowsForDatasetFixed(dkey), ...baselinePlotRowsForDataset(dkey)];
    }

    function reasoningSourceRows(dkey) {
      return rows.filter(r =>
        r.dataset_key === dkey &&
        r.type === "method" &&
        String(r.name || "") === "reasoning_check" &&
        !r._placeholder
      );
    }

    function selectReasoningRow(dkey, variant) {
      const pool = reasoningSourceRows(dkey);
      const exactTag = `${String(variant.runStem || "")}${dkey}`;
      const exact = pool.filter(r =>
        String(r.run_tag || "") === exactTag ||
        String(r.model || "") === exactTag ||
        String(r.run_tag || "") === `${dkey}_metrics_overall_${exactTag}` ||
        String(r.source_file || "").includes(`/${exactTag}/`)
      );
      return pickBestRow(exact);
    }

    function selectM6ReasoningRow(dkey, variant, modeTag) {
      const pool = methodRowsByName(dkey, "m6_self_debiasing");
      const suffixes = variant.m6Suffix
        ? [String(variant.m6Suffix)]
        : (variant.m5Suffixes || []);
      for (const suffix of suffixes) {
        const exactTag = `${modeTag}__${suffix}`;
        const exact = pool.filter(r =>
          String(r.run_tag || "") === exactTag ||
          String(r.model || "") === exactTag ||
          String(r.run_tag || "") === `${dkey}_metrics_overall_${exactTag}`
        );
        if (exact.length) return pickBestRow(exact);
        const prefixed = pool.filter(r =>
          String(r.run_tag || "").startsWith(`${exactTag}_`) ||
          String(r.run_tag || "").startsWith(`${dkey}_metrics_overall_${exactTag}_`) ||
          String(r.source_file || "").includes(`/${exactTag}/`)
        );
        if (prefixed.length) return pickBestRow(prefixed);
      }
      return null;
    }

    function plotRowsForReasoningDataset(dkey) {
      const result = [];
      for (const v of REASONING_MODEL_VARIANTS) {
        result.push(makePlotRow(dkey, v.group, v.label, selectReasoningRow(dkey, v), v.rowType));
      }
      for (const v of M6_PLOT_VARIANTS) {
        const rowZero = selectM6ReasoningRow(dkey, v, "m6_two_pass");
        if (rowZero) result.push(makePlotRow(dkey, "m6 self-debias (two-pass 0-shot)", v.label, rowZero));
        const rowOne = selectM6ReasoningRow(dkey, v, "m6_two_pass_one");
        if (rowOne) result.push(makePlotRow(dkey, "m6 self-debias (two-pass 1-shot)", v.label, rowOne));
        const rowTwo = selectM6ReasoningRow(dkey, v, "m6_two_pass_two");
        if (rowTwo) result.push(makePlotRow(dkey, "m6 self-debias (two-pass 2-shot)", v.label, rowTwo));
      }
      result.push(...baselinePlotRowsForDataset(dkey));
      return result;
    }

    function excludeRowForMetric(dkey, metricKey, row) {
      if (!row) return false;
      if (
        dkey === "bbq" &&
        row.type === "method" &&
        row.name === "m6_self_debiasing" &&
        /all_strategies/i.test(String(row.run_tag || ""))
      ) {
        return true;
      }
      if (
        dkey === "bbq" &&
        metricKey === "Bias_score_disambig" &&
        row.type === "baseline" &&
        String(row.name || "").startsWith("self_debiasing_")
      ) {
        return true;
      }
      return false;
    }

    function methodFamily(row) {
      if (!row || row.type !== "method") return "";
      const rowName = String(row.name || "").trim().toLowerCase();
      if (rowName === "m6 self-debias (two-pass 0-shot)") return "m6 0-shot";
      if (rowName === "m6 self-debias (two-pass 1-shot)") return "m6 1-shot";
      if (rowName === "m6 self-debias (two-pass 2-shot)") return "m6 2-shot";
      if (rowName === "m6 self-debias (non-cog)") return "m6 non-cog";
      const probes = [
        String(row.name || ""),
        String(row.run_tag || ""),
        String(row.source_file || ""),
      ];
      for (const text of probes) {
        const t = text.trim();
        let m = t.match(/^(m\d+)/i);
        if (m) return String(m[1]).toLowerCase();
        m = t.match(/(?:^|[_\-\s])(m\d+)(?:[_\-\s]|$)/i);
        if (m) return String(m[1]).toLowerCase();
      }
      return "";
    }

    function sortedMethodFamilies(values) {
      return [...new Set(values)]
        .filter(Boolean)
        .sort((a, b) => {
          const ai = Number.parseInt(String(a).replace(/^m/i, ""), 10);
          const bi = Number.parseInt(String(b).replace(/^m/i, ""), 10);
          if (Number.isFinite(ai) && Number.isFinite(bi) && ai !== bi) return ai - bi;
          return String(a).localeCompare(String(b));
        });
    }

    function passesMethodFamilyFilter(row) {
      if (!row || row.type !== "method") return true;
      const fam = methodFamily(row);
      if (!fam) return true;
      if (!state.selectedMethodFamilies || state.selectedMethodFamilies.size === 0) return true;
      return state.selectedMethodFamilies.has(fam);
    }

    function refreshMethodFamilyFilters() {
      const presentKeys = new Set(rows.map(r => String(r.dataset_key || "")).filter(k => k && k !== "__overview__"));
      const view = currentView();
      const overviewDatasetKeys = (view.key === "reasoning" ? REASONING_DATASET_KEYS : PLOT_DATASET_KEYS)
        .filter(d => presentKeys.has(d));
      const availableFamilies = sortedMethodFamilies(
        overviewDatasetKeys
          .flatMap(d => view.key === "reasoning" ? plotRowsForReasoningDataset(d) : plotRowsForDatasetFixed(d))
          .map(r => methodFamily(r))
      );

      if (!availableFamilies.length) {
        els.methodFamilyFilters.innerHTML = "";
        return;
      }

      if (!state.methodFamiliesInitialized) {
        state.selectedMethodFamilies = new Set(availableFamilies);
        state.methodFamiliesInitialized = true;
      } else {
        const next = new Set();
        for (const fam of availableFamilies) {
          if (state.selectedMethodFamilies.has(fam)) next.add(fam);
        }
        state.selectedMethodFamilies = next;
      }

      const chips = availableFamilies.map(fam => {
        const checked = state.selectedMethodFamilies.has(fam) ? "checked" : "";
        return `<label class="method-family-chip"><input type="checkbox" data-method-family="${escapeHtml(fam)}" ${checked}> ${escapeHtml(fam)}</label>`;
      }).join("");
      els.methodFamilyFilters.innerHTML = `
        <span class="method-family-title">method families</span>
        <span class="method-family-actions">
          <button type="button" id="methodFamiliesAll">all</button>
          <button type="button" id="methodFamiliesNone">none</button>
        </span>
        ${chips}
      `;

      const allBtn = document.getElementById("methodFamiliesAll");
      const noneBtn = document.getElementById("methodFamiliesNone");
      if (allBtn) {
        allBtn.addEventListener("click", () => {
          state.selectedMethodFamilies = new Set(availableFamilies);
          render();
        });
      }
      if (noneBtn) {
        noneBtn.addEventListener("click", () => {
          state.selectedMethodFamilies = new Set();
          render();
        });
      }
      els.methodFamilyFilters
        .querySelectorAll("input[type='checkbox'][data-method-family]")
        .forEach(el => {
          el.addEventListener("change", (e) => {
            const fam = String(e.target.getAttribute("data-method-family") || "").toLowerCase();
            if (!fam) return;
            if (e.target.checked) state.selectedMethodFamilies.add(fam);
            else state.selectedMethodFamilies.delete(fam);
            render();
          });
        });
    }

    function metricDirectionNote(direction) {
      if (direction === "higher") return "higher is better";
      if (direction === "target50") return "closer to 50 is better";
      if (direction === "target0") return "closer to 0 is better";
      return "lower is better";
    }

    function fillWidthPercent(direction, value, values) {
      if (!Number.isFinite(value) || !values.length) return 0;
      if (direction === "target50") {
        const dists = values.map(v => Math.abs(v - 50));
        const d = Math.abs(value - 50);
        const minD = Math.min(...dists);
        const maxD = Math.max(...dists);
        if (maxD === minD) return 100;
        const t = 1 - ((d - minD) / (maxD - minD));
        return Math.max(0, Math.min(100, t * 100));
      }
      if (direction === "target0") {
        const dists = values.map(v => Math.abs(v));
        const d = Math.abs(value);
        const minD = Math.min(...dists);
        const maxD = Math.max(...dists);
        if (maxD === minD) return 100;
        const t = 1 - ((d - minD) / (maxD - minD));
        return Math.max(0, Math.min(100, t * 100));
      }
      const min = Math.min(...values);
      const max = Math.max(...values);
      if (max === min) return 100;
      let t = (value - min) / (max - min);
      if (direction === "lower") t = 1 - t;
      return Math.max(0, Math.min(100, t * 100));
    }

    function metricSortValue(direction, value) {
      if (!Number.isFinite(value)) return Number.POSITIVE_INFINITY;
      if (direction === "higher") return -value;
      if (direction === "target50") return Math.abs(value - 50);
      if (direction === "target0") return Math.abs(value);
      return value;
    }

    function renderDatasetMethodPlots() {
      const availableKeys = new Set(rows.map(r => String(r.dataset_key || "")).filter(k => k && k !== "__overview__"));
      const keys = PLOT_DATASET_KEYS.filter(k => availableKeys.has(k));
      let seq = 0;
      const cardObjs = keys.flatMap(dkey => {
        const meta = datasetMeta[dkey] || { label: dkey, direction: "lower", score_label: "score" };
        const q = state.search.trim().toLowerCase();
        const baseRows = plotRowsForDatasetCombined(dkey).filter(r => {
          if (r.type === "method" && !state.showMethods) return false;
          if (!passesMethodFamilyFilter(r)) return false;
          if (r.type === "baseline" && !state.showBaselines) return false;
          if (r.type === "base_model" && !state.showBaseModel) return false;
          if (!q) return true;
          const blob = `${r.type} ${r.name} ${r.strategy} ${r.run_tag}`.toLowerCase();
          return blob.includes(q);
        });
        if (!baseRows.length) {
          return [{
            key: `${dkey}|__empty__`,
            seq: seq++,
            html: `<section class="overview-card">
            <h3>${escapeHtml(meta.label)}</h3>
            <div class="plot-empty">No rows for current filters.</div>
          </section>`
          }];
        }
        const metricDefs = DATASET_PAPER_METRICS[dkey] || [{ key: "score", label: meta.score_label || "score", direction: meta.direction || "lower" }];
        return metricDefs.map(metric => {
          const metricRows = baseRows
            .filter(r => !excludeRowForMetric(dkey, metric.key, r))
            .map(r => {
            const v = metricValue(r, metric.key);
            return { ...r, _metricValue: v };
          }).sort((a, b) => {
            const av = Number(a._metricValue);
            const bv = Number(b._metricValue);
            const aMissing = !Number.isFinite(av);
            const bMissing = !Number.isFinite(bv);
            if (aMissing !== bMissing) return aMissing ? 1 : -1;
            const ak = metricSortValue(metric.direction || "lower", av);
            const bk = metricSortValue(metric.direction || "lower", bv);
            if (ak !== bk) return ak - bk;
            const nameCmp = String(a.name || "").localeCompare(String(b.name || ""));
            if (nameCmp !== 0) return nameCmp;
            const stratCmp = String(a.strategy || "").localeCompare(String(b.strategy || ""));
            if (stratCmp !== 0) return stratCmp;
            return String(a.run_tag || "").localeCompare(String(b.run_tag || ""));
          });
          const scoredRows = metricRows.filter(r => Number.isFinite(r._metricValue));
          const vals = scoredRows.map(r => Number(r._metricValue));
          const rowsHtml = metricRows.map(r => {
            const score = Number(r._metricValue);
            const missing = !Number.isFinite(score);
            const pct = missing ? 0 : fillWidthPercent(metric.direction || "lower", score, vals);
            const strategy = (r.strategy || "--").trim();
            const scoreText = missing ? "--" : score.toFixed(6).replace(/0+$/, "").replace(/\.$/, "");
            const tag = (r.run_tag || "").trim();
            const strategyLabel = strategy;
            const baseClass = (r.type === "baseline" || r.type === "base_model") ? "baseline" : "method";
            const methodShadeClass =
              (r.type === "method" && String(r.name || "") === "m3 ft (ms-500)") ? "m3-ms500"
              : (r.type === "method" && String(r.name || "") === "m3 ft (ms-full)") ? "m3-msfull"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (two-pass 0-shot)") ? "m6-zero"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (two-pass 1-shot)") ? "m6-one"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (two-pass 2-shot)") ? "m6-two"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (non-cog)") ? "m6-noncog"
              : "";
            const fillClass = [baseClass, methodShadeClass, (missing ? "missing" : "")]
              .filter(Boolean)
              .join(" ");
            return `<div class="bar-row${missing ? " missing" : ""}">
              <div class="bar-label" title="${escapeHtml(r.name)}">${escapeHtml(r.name)}${tag ? `<span class="bar-sub">${escapeHtml(tag)}</span>` : ''}</div>
              <div class="bar-strategy" title="${escapeHtml(strategyLabel)}">${escapeHtml(strategyLabel)}</div>
              <div class="bar-track"><div class="bar-fill ${fillClass}" style="width:${pct}%"></div></div>
              <div class="bar-value${missing ? " missing" : ""}">${scoreText}</div>
            </div>`;
          }).join("");
          const scoredCount = scoredRows.length;
          return {
            key: `${dkey}|${metric.key}`,
            seq: seq++,
            html: `<section class="overview-card">
            <h3>${escapeHtml(meta.label)}: ${escapeHtml(metric.label)}</h3>
            <div class="overview-note">Direction: ${escapeHtml(metricDirectionNote(metric.direction || "lower"))}.</div>
            <div class="bar-list">${rowsHtml}</div>
          </section>`
          };
        });
      });
      const ordered = cardObjs.slice().sort((a, b) => {
        const ai = Object.prototype.hasOwnProperty.call(PINNED_METRIC_INDEX, a.key) ? PINNED_METRIC_INDEX[a.key] : Number.POSITIVE_INFINITY;
        const bi = Object.prototype.hasOwnProperty.call(PINNED_METRIC_INDEX, b.key) ? PINNED_METRIC_INDEX[b.key] : Number.POSITIVE_INFINITY;
        if (ai !== bi) return ai - bi;
        return a.seq - b.seq;
      });
      const cards = ordered.map(c => c.html).join("");
      els.plotDatasetGrid.innerHTML = cards || '<section class="overview-card"><div class="plot-empty">No plot datasets with results found.</div></section>';
    }

    function renderReasoningPlots() {
      const availableKeys = new Set(rows.map(r => String(r.dataset_key || "")).filter(k => k && k !== "__overview__"));
      const keys = REASONING_DATASET_KEYS.filter(k => availableKeys.has(k));
      let seq = 0;
      const cardObjs = keys.flatMap(dkey => {
        const meta = datasetMeta[dkey] || { label: dkey, direction: "higher", score_label: "accuracy" };
        const q = state.search.trim().toLowerCase();
        const baseRows = plotRowsForReasoningDataset(dkey).filter(r => {
          if (r.type === "method" && !state.showMethods) return false;
          if (!passesMethodFamilyFilter(r)) return false;
          if (r.type === "baseline" && !state.showBaselines) return false;
          if (r.type === "base_model" && !state.showBaseModel) return false;
          if (!q) return true;
          const blob = `${r.type} ${r.name} ${r.strategy} ${r.run_tag}`.toLowerCase();
          return blob.includes(q);
        });
        if (!baseRows.length) {
          return [{
            key: `${dkey}|__empty__`,
            seq: seq++,
            html: `<section class="overview-card">
            <h3>${escapeHtml(meta.label)}</h3>
            <div class="plot-empty">No rows for current filters.</div>
          </section>`
          }];
        }
        const metricDefs = DATASET_REASONING_METRICS[dkey] || [{ key: "score", label: meta.score_label || "score", direction: meta.direction || "higher" }];
        return metricDefs.map(metric => {
          const metricRows = baseRows
            .map(r => ({ ...r, _metricValue: metricValue(r, metric.key) }))
            .sort((a, b) => {
              const av = Number(a._metricValue);
              const bv = Number(b._metricValue);
              const aMissing = !Number.isFinite(av);
              const bMissing = !Number.isFinite(bv);
              if (aMissing !== bMissing) return aMissing ? 1 : -1;
              const ak = metricSortValue(metric.direction || "higher", av);
              const bk = metricSortValue(metric.direction || "higher", bv);
              if (ak !== bk) return ak - bk;
              const nameCmp = String(a.name || "").localeCompare(String(b.name || ""));
              if (nameCmp !== 0) return nameCmp;
              const stratCmp = String(a.strategy || "").localeCompare(String(b.strategy || ""));
              if (stratCmp !== 0) return stratCmp;
              return String(a.run_tag || "").localeCompare(String(b.run_tag || ""));
            });
          const scoredRows = metricRows.filter(r => Number.isFinite(r._metricValue));
          const vals = scoredRows.map(r => Number(r._metricValue));
          const rowsHtml = metricRows.map(r => {
            const score = Number(r._metricValue);
            const missing = !Number.isFinite(score);
            const pct = missing ? 0 : fillWidthPercent(metric.direction || "higher", score, vals);
            const strategy = (r.strategy || "--").trim();
            const scoreText = missing ? "--" : score.toFixed(6).replace(/0+$/, "").replace(/\.$/, "");
            const tag = (r.run_tag || "").trim();
            const baseClass = (r.type === "baseline" || r.type === "base_model") ? "baseline" : "method";
            const methodShadeClass =
              (r.type === "method" && String(r.name || "") === "m3 ft (ms-500)") ? "m3-ms500"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (two-pass 0-shot)") ? "m6-zero"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (two-pass 1-shot)") ? "m6-one"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (two-pass 2-shot)") ? "m6-two"
              : (r.type === "method" && String(r.name || "") === "m6 self-debias (non-cog)") ? "m6-noncog"
              : "";
            const fillClass = [baseClass, methodShadeClass, (missing ? "missing" : "")]
              .filter(Boolean)
              .join(" ");
            return `<div class="bar-row${missing ? " missing" : ""}">
              <div class="bar-label" title="${escapeHtml(r.name)}">${escapeHtml(r.name)}${tag ? `<span class="bar-sub">${escapeHtml(tag)}</span>` : ''}</div>
              <div class="bar-strategy" title="${escapeHtml(strategy)}">${escapeHtml(strategy)}</div>
              <div class="bar-track"><div class="bar-fill ${fillClass}" style="width:${pct}%"></div></div>
              <div class="bar-value${missing ? " missing" : ""}">${scoreText}</div>
            </div>`;
          }).join("");
          return {
            key: `${dkey}|${metric.key}`,
            seq: seq++,
            html: `<section class="overview-card">
            <h3>${escapeHtml(meta.label)}: ${escapeHtml(metric.label)}</h3>
            <div class="overview-note">Direction: ${escapeHtml(metricDirectionNote(metric.direction || "higher"))}.</div>
            <div class="bar-list">${rowsHtml}</div>
          </section>`
          };
        });
      });
      const ordered = cardObjs.slice().sort((a, b) => a.seq - b.seq);
      const cards = ordered.map(c => c.html).join("");
      els.plotDatasetGrid.innerHTML = cards || '<section class="overview-card"><div class="plot-empty">No reasoning datasets with results found.</div></section>';
    }

    function escapeHtml(s) {
      return String(s || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    function render() {
      const view = currentView();
      updateViewNav();
      refreshMethodFamilyFilters();
      const q = state.search.trim().toLowerCase();
      const presentKeys = new Set(rows.map(r => String(r.dataset_key || "")).filter(k => k && k !== "__overview__"));
      const overviewDatasetKeys = (view.key === "reasoning" ? REASONING_DATASET_KEYS : PLOT_DATASET_KEYS)
        .filter(d => presentKeys.has(d));
      const usedRows = overviewDatasetKeys
        .flatMap(d => view.key === "reasoning" ? plotRowsForReasoningDataset(d) : plotRowsForDatasetCombined(d))
        .filter(r => {
          if (r.type === "method" && !state.showMethods) return false;
          if (!passesMethodFamilyFilter(r)) return false;
          if (r.type === "baseline" && !state.showBaselines) return false;
          if (r.type === "base_model" && !state.showBaseModel) return false;
          if (!q) return true;
          const blob = `${r.type} ${r.name} ${r.strategy} ${r.run_tag}`.toLowerCase();
          return blob.includes(q);
        });
      let scored = 0;
      let missing = 0;
      for (const row of usedRows) {
        const rowMetricDefs = (view.key === "reasoning" ? DATASET_REASONING_METRICS : DATASET_PAPER_METRICS)[row.dataset_key] || [];
        for (const metric of rowMetricDefs) {
          if (hasFiniteMetric(row, metric.key)) scored += 1;
          else missing += 1;
        }
      }
      const methods = usedRows.filter(r => r.type === "method").length;
      const baselines = usedRows.filter(r => r.type === "baseline").length;
      const baseModels = usedRows.filter(r => r.type === "base_model").length;
      if (view.key === "reasoning") {
        els.metricInfo.textContent = "Reasoning ability metrics on Balanced-COPA, ARC-Easy, and ARC-Challenge.";
      } else {
        els.metricInfo.textContent = "Paper metrics per dataset (CrowS-Pairs, StereoSet, WinoBias, WinoGender, BBQ). Bias in Bios plots removed.";
      }
      els.countInfo.textContent = `Rows in plots: ${usedRows.length} (methods: ${methods}, baselines: ${baselines}, base model: ${baseModels}) | Metric values: scored=${scored}, missing=${missing}`;
      els.overviewPanel.classList.add("active");
      if (view.key === "reasoning") renderReasoningPlots();
      else renderDatasetMethodPlots();
    }

    els.viewPrev.addEventListener("click", () => {
      if (state.viewIndex > 0) {
        state.viewIndex -= 1;
        state.methodFamiliesInitialized = false;
        render();
      }
    });
    els.viewNext.addEventListener("click", () => {
      if (state.viewIndex < VIEWS.length - 1) {
        state.viewIndex += 1;
        state.methodFamiliesInitialized = false;
        render();
      }
    });
    els.showMethods.addEventListener("change", (e) => { state.showMethods = e.target.checked; render(); });
    els.showBaselines.addEventListener("change", (e) => { state.showBaselines = e.target.checked; render(); });
    els.showBaseModel.addEventListener("change", (e) => { state.showBaseModel = e.target.checked; render(); });
    els.search.addEventListener("input", (e) => { state.search = e.target.value || ""; render(); });

    render();
  </script>
</body>
</html>
