        { key: "LM Score", label: "LM (overall)", direction: "higher" },
        { key: "ICAT Score", label: "ICAT (overall)", direction: "higher" },
        { key: "SS_intrasentence", label: "SS (intrasentence)", direction: "target50" },
        { key: "LM_intrasentence", label: "LM (intrasentence)", direction: "higher" },
        { key: "ICAT_intrasentence", label: "ICAT (intrasentence)", direction: "higher" },
