    const PLOT_DATASET_KEYS = ["crowspairs", "stereoset", "winobias", "winogender", "bbq"];
    const REASONING_DATASET_KEYS = ["balanced_copa", "arc_easy", "arc_challenge"];

    const DATASET_PAPER_METRICS = {
      crowspairs: [
        { key: "metric_score", label: "Stereotype Preference (%)", direction: "target50" }
      ],
      stereoset: [
