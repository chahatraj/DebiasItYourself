<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Results by Dataset</title>
  <style>
    :root {
      --bg: #f4f1ea;
      --panel: #fffdf8;
      --ink: #1f2a33;
      --muted: #596672;
      --accent: #c7663d;
      --accent-soft: #e8b59b;
      --method: #2f8f83;
      --baseline: #2e5eaa;
      --other: #8f5d2f;
      --line: #d9d1c4;
      --good: #b9e5c6;
      --mid: #fff0bf;
      --bad: #f2c2bd;
      --bar-method-start: #0a7a7a;
      --bar-method-end: #159191;
      --bar-m3-ms500-start: #086f6f;
      --bar-m3-ms500-end: #128585;
      --bar-m3-msfull-start: #1f9f9f;
      --bar-m3-msfull-end: #34b1b1;
      --bar-m6-zero-start: #b88ce8;
      --bar-m6-zero-end: #cf9fff;
      --bar-m6-one-start: #c85fc4;
      --bar-m6-one-end: #da70d6;
      --bar-m6-two-start: #a72fa7;
      --bar-m6-two-end: #bf40bf;
      --bar-m6-noncog-start: #3f51b5;
      --bar-m6-noncog-end: #5c6bc0;
      --bar-baseline-start: #d03a54;
      --bar-baseline-end: #de536a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Avenir Next", "Segoe UI", "Trebuchet MS", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 14% 12%, #f6d8bf 0%, rgba(246,216,191,0) 42%),
        radial-gradient(circle at 85% 20%, #c9deef 0%, rgba(201,222,239,0) 43%),
        linear-gradient(180deg, #fcf9f5 0%, var(--bg) 100%);
      min-height: 100vh;
    }
    .wrap {
      max-width: 1500px;
      margin: 0 auto;
      padding: 22px 18px 26px;
    }
    h1 {
      margin: 0 0 6px;
      font-size: clamp(1.5rem, 2.2vw, 2.05rem);
      letter-spacing: .01em;
    }
    .subtitle {
      margin: 0;
      font-size: 1.0rem;
      color: var(--muted);
    }
    .panel {
      margin-top: 16px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--panel);
      box-shadow: 0 12px 32px rgba(33, 43, 54, .07);
      overflow: hidden;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(90deg, rgba(246,216,191,.22), rgba(201,222,239,.22));
    }
    .view-nav {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding-right: 8px;
      border-right: 1px solid #d2c7b8;
      margin-right: 2px;
    }
    .view-nav button {
      border: 1px solid #c5baaa;
      border-radius: 8px;
      background: #fffaf2;
      color: #43505c;
      font-size: .82rem;
      padding: 4px 10px;
      cursor: pointer;
    }
    .view-nav button:disabled {
      cursor: default;
      opacity: .45;
    }
    .view-label {
      min-width: 190px;
      font-size: .88rem;
      font-weight: 600;
      color: #3e4d58;
      text-align: center;
    }
    input[type="text"] {
      border: 1px solid #c5baaa;
      border-radius: 10px;
      background: #fff;
      color: var(--ink);
      font-size: .9rem;
      padding: 7px 10px;
    }
    .spacer { flex: 1; }
    .checks {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: .88rem;
      color: var(--muted);
    }
    .checks label {
      display: inline-flex;
      gap: 4px;
      align-items: center;
    }
    .method-family-filters {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px 10px;
      font-size: .86rem;
      color: var(--muted);
      border-left: 1px solid #d2c7b8;
      padding-left: 10px;
      margin-left: 2px;
    }
    .method-family-title {
      font-weight: 600;
      color: #4a5863;
    }
    .method-family-chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      white-space: nowrap;
    }
    .method-family-actions {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-right: 2px;
    }
    .method-family-actions button {
      border: 1px solid #c5baaa;
      border-radius: 8px;
      background: #fffaf2;
      color: #43505c;
      font-size: .78rem;
      padding: 2px 8px;
      cursor: pointer;
    }
    .method-family-actions button:hover {
      background: #f5ecdf;
    }
    .meta {
      padding: 10px 14px 6px;
      font-size: .88rem;
      color: var(--muted);
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .overview {
      padding: 14px;
      border-top: 1px solid var(--line);
      display: none;
    }
    .overview.active {
      display: block;
    }
    .overview-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .overview-card {
      border: 1px solid #e2d8cb;
      border-radius: 12px;
      background: #fffaf3;
      padding: 10px;
      min-height: 250px;
    }
    .overview-card h3 {
      margin: 0 0 8px;
      font-size: .92rem;
      color: #394651;
    }
    .overview-note {
      margin: 0 0 10px;
      font-size: .83rem;
      color: #63717e;
    }
    .plot-empty {
      color: #7b8793;
      font-size: .86rem;
    }
    .bar-list {
      display: grid;
      gap: 0;
    }
    .bar-row {
      display: grid;
      grid-template-columns: minmax(220px, 1.45fr) minmax(56px, 0.5fr) 1.65fr 58px;
      gap: 8px;
      align-items: center;
      font-size: .78rem;
    }
    .bar-label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: #33424d;
      font-weight: 600;
    }
    .bar-sub {
      margin-left: 4px;
      font-size: .68rem;
      color: #7d8893;
      font-weight: 500;
    }
    .bar-strategy {
      font-size: .7rem;
      color: #6c7782;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .bar-track {
      height: 12px;
      border-radius: 999px;
      background: #f0e7da;
      overflow: hidden;
      border: 1px solid #eadfce;
    }
    .bar-row.missing .bar-track {
      border-style: dashed;
      background: #f6efe3;
    }
    .bar-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #d9cdbd 0%, #c9baa8 100%);
    }
    .bar-fill.method {
      background: linear-gradient(90deg, var(--bar-method-start) 0%, var(--bar-method-end) 100%);
    }
    .bar-fill.method.m3-ms500 {
      background: linear-gradient(90deg, var(--bar-m3-ms500-start) 0%, var(--bar-m3-ms500-end) 100%);
    }
    .bar-fill.method.m3-msfull {
      background: linear-gradient(90deg, var(--bar-m3-msfull-start) 0%, var(--bar-m3-msfull-end) 100%);
    }
    .bar-fill.method.m6-zero {
      background: linear-gradient(90deg, var(--bar-m6-zero-start) 0%, var(--bar-m6-zero-end) 100%);
    }
    .bar-fill.method.m6-one {
      background: linear-gradient(90deg, var(--bar-m6-one-start) 0%, var(--bar-m6-one-end) 100%);
    }
    .bar-fill.method.m6-two {
      background: linear-gradient(90deg, var(--bar-m6-two-start) 0%, var(--bar-m6-two-end) 100%);
    }
    .bar-fill.method.m6-noncog {
      background: linear-gradient(90deg, var(--bar-m6-noncog-start) 0%, var(--bar-m6-noncog-end) 100%);
    }
    .bar-fill.baseline {
      background: linear-gradient(90deg, var(--bar-baseline-start) 0%, var(--bar-baseline-end) 100%);
    }
    .bar-fill.missing {
      background: repeating-linear-gradient(
        90deg,
        #dccfbd 0px,
        #dccfbd 8px,
        #f1e8dd 8px,
        #f1e8dd 16px
      );
    }
    .bar-value {
      font-variant-numeric: tabular-nums;
      text-align: right;
      color: #3f4f5a;
    }
    .bar-value.missing {
      color: #8a7967;
      font-weight: 700;
    }
    .foot {
      padding: 9px 14px 14px;
      color: #647382;
      font-size: .78rem;
    }
    @media (max-width: 1100px) {
      .overview-grid {
        grid-template-columns: 1fr;
      }
      .bar-row {
        grid-template-columns: minmax(150px, 1.25fr) minmax(52px, 0.45fr) 1.4fr 50px;
      }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>All Results by Dataset</h1>
    <p class="subtitle">Plots-only view with paper-aligned metrics across methods, baselines, and base model.</p>
    <div class="panel">
      <div class="controls">
        <div class="view-nav">
          <button id="viewPrev" type="button">Previous</button>
          <span id="viewLabel" class="view-label">Bias Results</span>
          <button id="viewNext" type="button">Next</button>
        </div>
        <div class="checks">
          <label><input id="showMethods" type="checkbox" checked> methods</label>
          <label><input id="showBaselines" type="checkbox" checked> baselines</label>
          <label><input id="showBaseModel" type="checkbox" checked> base model</label>
        </div>
        <div id="methodFamilyFilters" class="method-family-filters"></div>
        <div class="spacer"></div>
        <input id="search" type="text" placeholder="Search name/tag/path..." />
      </div>
      <div class="meta">
        <span id="metricInfo"></span>
        <span id="countInfo"></span>
      </div>
      <div id="overviewPanel" class="overview">
        <p class="overview-note">Paper-aligned metric plots only.</p>
        <div id="plotDatasetGrid" class="overview-grid"></div>
      </div>
      <div class="foot">Generated: 2026-04-13 17:37:20 | Source CSV: results/new_results/all_results_dataset_slides.csv</div>
    </div>
  </div>

